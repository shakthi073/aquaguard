# Database (SQLite — file created automatically on migrate)
DATABASE_URL="file:./dev.db"

# Google Gemini — required for real AI image verification
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.8-flash"

# Email via Resend — required for reporter & authority notifications
# Sign up at https://resend.com
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="AquaGuard <onboarding@resend.dev>"

# Where new complaints are emailed (Pollution Control Board / authority inbox)
AUTHORITY_EMAIL="authority@example.com"

# Admin portal API key — used to update complaint status at /admin
ADMIN_API_KEY="change-this-to-a-long-random-secret"

# Public app URL (used in email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenStreetMap Nominatim user agent (required by their usage policy)
NOMINATIM_USER_AGENT="AquaGuard/1.0 (contact: you@example.com)"
